{
  "name": "@restorecommerce/ostorage-srv",
  "version": "1.2.3",
  "description": "Restorecommerce microservice for storing objects",
  "main": "lib/start.js",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/ostorage-srv.git"
  },
  "license": "MIT",
  "keywords": [
    "restore",
    "commerce",
    "microservice",
    "ostorage",
    "srv"
  ],
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@restorecommerce/acs-client": "^3.2.1",
    "@restorecommerce/chassis-srv": "^1.9.1",
    "@restorecommerce/grpc-client": "^2.3.1",
    "@restorecommerce/kafka-client": "^1.4.1",
    "@restorecommerce/logger": "^1.4.1",
    "@restorecommerce/rc-grpc-clients": "^5.2.1",
    "@restorecommerce/resource-base-interface": "^1.10.1",
    "@restorecommerce/service-config": "^1.2.1",
    "koa-multer": "^1.0.2",
    "lodash-es": "^4.18.1",
    "multer-s3": "^3.0.1",
    "redis": "^6.0.0",
    "s3-upload-stream": "^1.0.7",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@alenon/grpc-mock-server": "^3.2.9",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@grpc/proto-loader": "^0.8.1",
    "@restorecommerce/dev": "^0.3.0",
    "@restorecommerce/protos": "^6.16.1",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "10.0.10",
    "@types/node": "25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "c8": "^11.0.0",
    "coveralls": "3.1.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "husky": "9.1.7",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "should": "^13.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "start": "node lib/start.cjs",
    "dev": "cross-env NODE_ENV=development node --watch lib/start.cjs",
    "tsctests": "tsc -d -p tsconfig.test.json",
    "test": "npm run lint && vitest run",
    "lint": "eslint src",
    "mocha": "cross-env NODE_ENV=test mocha --full-trace --exit --timeout 15000",
    "test-debug": "cross-env NODE_ENV=test mocha -R spec test/test.js --inspect-brk",
    "lcov-report": "c8 report --reporter=lcov",
    "coveralls": "c8 report --reporter=text-lcov | coveralls",
    "build:es": "node esbuild.mjs",
    "build:clean": "rimraf lib",
    "build": "npm-run-all lint build:clean build:es",
    "postbuild": "mkdir -p dist && cp node_modules/@platformatic/wasm-utils/dist/native.wasm dist/",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "engines": {
    "node": ">= 20.8.0"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/ostorage-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/ostorage-srv",
          "skipLogin": true
        }
      ]
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
